{
  "name": "@proton1917/dsh-web-background",
  "version": "0.1.0",
  "description": "Third-party DSH Web background and semantic glass theme",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc && tsdown",
    "dev": "tsdown --watch",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proton1917/dsh-harness-plugin.git",
    "directory": "packages/web-background"
  },
  "homepage": "https://github.com/Proton1917/dsh-harness-plugin#readme",
  "bugs": {
    "url": "https://github.com/Proton1917/dsh-harness-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "background",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.1-rc.2",
    "jsdom": "^26.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  },
  "files": [
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src/assets/background.webp",
    "ASSET_NOTICE.md",
    "LICENSE",
    "README.md"
  ]
}
